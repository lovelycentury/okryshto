{
  "name": "@okkly/iam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Keycloak login theme — Keycloakify + React + @okkly/react",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
