# Inner Caddy: HTTP only, no host ports.

{
	auto_https off
}

(common) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

http://okryshto.dev, http://www.okryshto.dev {
	import common
	reverse_proxy profile:5200
}

http://storybook.okryshto.dev {
	import common
	reverse_proxy storybook:80
}

http://iam.okryshto.dev {
	import common
	reverse_proxy iam:8080
}
