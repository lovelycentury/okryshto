# Inner Caddy: HTTP only, no host ports.

{
	auto_https off

	# TLS is terminated one hop up (~/vps-infra Caddy). Without this, Caddy
	# rewrites X-Forwarded-Proto to the scheme it sees itself — plain `http` —
	# and Keycloak (KC_PROXY_HEADERS=xforwarded) then advertises http:// URLs
	# on an https:// page. Trusting the upstream keeps the original `https`.
	servers {
		trusted_proxies static private_ranges
	}
}

(common) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

http://okryshto.dev, http://www.okryshto.dev {
	import common
	reverse_proxy profile:5200
}

http://storybook.okryshto.dev {
	import common
	reverse_proxy storybook:80
}

http://iam.okryshto.dev {
	import common
	reverse_proxy iam:8080
}

# Split origin: the SPA on one host, its backend on another. The SPA is built
# with VITE_API_BASE_URL=https://resume-api.okryshto.dev (see deploy.yml /
# Dockerfile.resume-fe), and resume-be's CORS_ORIGINS lists the SPA host.
http://resume.okryshto.dev {
	import common
	reverse_proxy resume-fe:80
}

http://resume-api.okryshto.dev {
	import common
	reverse_proxy resume-be:5300
}
